<Page
    x:Class="Optim.App.Views.PackagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Optim.App.Views">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="2" Margin="0,0,0,4">
            <TextBlock Text="Packages" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Upgrades for what you have, installs for what you want — via winget."
                       Style="{StaticResource CardDescStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Check for updates" Click="Scan_Click" Style="{StaticResource BrandButtonStyle}"/>
            <Button Content="Upgrade selected" Click="Upgrade_Click"/>
            <TextBox x:Name="SearchBox" Width="260" PlaceholderText="Search winget…" KeyDown="SearchBox_KeyDown"/>
            <Button Content="Search" Click="Search_Click"/>
            <Button Content="Install selected" Click="Install_Click"/>
            <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.6"/>
        </StackPanel>

        <ListView x:Name="PackageList" Grid.Row="2" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:WingetRow">
                    <Grid Padding="4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"/>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind Id}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind InstalledVersion}" VerticalAlignment="Center" Opacity="0.8"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind AvailableVersion}" VerticalAlignment="Center" Foreground="Green"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Own row: an InfoBar opened from the list must not paint over the
             page header. -->
        <InfoBar x:Name="ResultInfo" Grid.Row="3" IsOpen="False" IsClosable="True"/>
    </Grid>
</Page>
