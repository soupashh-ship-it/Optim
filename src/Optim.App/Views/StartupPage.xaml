<Page
    x:Class="Optim.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Optim.App.Views">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="2" Margin="0,0,0,4">
            <TextBlock Text="Startup apps" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Everything that launches with Windows: Run keys (including 32-bit and one-time RunOnce entries), plus per-user and all-users startup folders. Toggles update approval state; Delete removes the entry. RunOnce and folder rows are read-only."
                       Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" MaxWidth="800"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Refresh" Click="Refresh_Click"/>
            <Button Content="Add app…" Click="Add_Click" Style="{StaticResource BrandButtonStyle}"/>
            <Button Content="Enable all" Click="EnableAll_Click"/>
            <Button Content="Disable all" Click="DisableAll_Click"/>
        </StackPanel>

        <ListView x:Name="StartupList" Grid.Row="2">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:StartupRow">
                    <Grid Padding="4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind Command}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind Location}" VerticalAlignment="Center" Opacity="0.5" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <ToggleSwitch IsOn="{x:Bind Enabled, Mode=TwoWay}" Toggled="Toggle_Toggled" MinWidth="0" Margin="0"
                                          IsEnabled="{x:Bind CanToggle}"/>
                            <Button Content="Delete" Click="Delete_Click"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
