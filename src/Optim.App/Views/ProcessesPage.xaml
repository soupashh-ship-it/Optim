<Page
    x:Class="Optim.App.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="2" Margin="0,0,0,4">
            <TextBlock Text="Processes" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Live processes. End what is stuck — critical ones are guarded."
                       Style="{StaticResource CardDescStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SearchBox" PlaceholderText="Search name, title, PID"
                     Width="240" KeyDown="SearchBox_KeyDown"/>
            <Button Content="Refresh" Click="Refresh_Click"/>
            <ToggleButton x:Name="AutoRefreshToggle" Content="Auto-refresh (5 s)" IsChecked="True"
                          Click="AutoRefresh_Click"/>
            <Button x:Name="EndTaskBtn" Content="End task" Click="EndTask_Click" Style="{StaticResource BrandButtonStyle}"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Opacity="0.6"/>
        </StackPanel>

        <ListView x:Name="ProcessList" Grid.Row="2" SelectionMode="Single">
            <ListView.Header>
                <Grid Padding="4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Process" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                    <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                    <TextBlock Grid.Column="2" Text="RAM" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                    <TextBlock Grid.Column="3" Text="Threads" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                    <TextBlock Grid.Column="4" Text="PID" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextBlockStyle}"/>
                            <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding CpuText}" VerticalAlignment="Center" Opacity="0.8" MinWidth="56"/>
                        <TextBlock Grid.Column="2" Text="{Binding RamText}" VerticalAlignment="Center" Opacity="0.8" MinWidth="72"/>
                        <TextBlock Grid.Column="3" Text="{Binding ThreadText}" VerticalAlignment="Center" Opacity="0.5" MinWidth="56"/>
                        <TextBlock Grid.Column="4" Text="{Binding Pid}" VerticalAlignment="Center" Opacity="0.5" MinWidth="56"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
