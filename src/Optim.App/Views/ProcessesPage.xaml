<Page
    x:Class="Optim.App.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Optim.App.Views">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="2" Margin="0,0,0,4">
            <TextBlock Text="Processes" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Live processes. End what is stuck, tune priority or CPU affinity — critical ones are guarded."
                       Style="{StaticResource CardDescStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SearchBox" PlaceholderText="Search name, title, PID"
                     Width="240" TextChanged="SearchBox_TextChanged"/>
            <Button Content="Refresh" Click="Refresh_Click"/>
            <ToggleButton x:Name="AutoRefreshToggle" Content="Auto-refresh (5 s)" IsChecked="True"
                          Click="AutoRefresh_Click"/>
            <Button x:Name="EndTaskBtn" Content="End task" Click="EndTask_Click" Style="{StaticResource BrandButtonStyle}"/>
            <Button x:Name="PriorityBtn" Content="Set priority" Click="Priority_Click" IsEnabled="False"/>
            <Button x:Name="AffinityBtn" Content="CPU affinity" Click="Affinity_Click" IsEnabled="False"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Opacity="0.6"/>
        </StackPanel>

        <ListView x:Name="ProcessList" Grid.Row="2" SelectionMode="Single">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Realize past the viewport so a flick scroll never catches up
                         with container creation and stalls mid-scroll. -->
                    <ItemsStackPanel CacheLength="5"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.Header>
                <Grid Padding="4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Process" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                    <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                    <TextBlock Grid.Column="2" Text="RAM" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                    <TextBlock Grid.Column="3" Text="Threads" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                    <TextBlock Grid.Column="4" Text="PID" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <!-- Compiled bindings, OneWay on the live numbers: auto-refresh
                     repaints the changed cells in place instead of rebuilding
                     the list every tick. -->
                <DataTemplate x:DataType="local:ProcessRow">
                    <Grid Padding="4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind WindowTitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind CpuText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8" MinWidth="56"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind RamText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8" MinWidth="72"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind ThreadText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.5" MinWidth="56"/>
                        <TextBlock Grid.Column="4" Text="{x:Bind Pid}" VerticalAlignment="Center" Opacity="0.5" MinWidth="56"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
