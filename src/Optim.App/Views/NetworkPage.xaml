<Page
    x:Class="Optim.App.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="2" Margin="0,0,0,4">
            <TextBlock Text="Network" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Adapters and DNS profiles. Apply a profile or reset to automatic."
                       Style="{StaticResource CardDescStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="AdapterBox" MinWidth="220" PlaceholderText="Select adapter"/>
            <Button Content="Refresh" Click="Refresh_Click"/>
            <Button Content="Flush DNS" Click="Flush_Click"/>
            <Button x:Name="ToggleAdapterBtn" Content="Disable adapter" Click="ToggleAdapter_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="DnsBox" MinWidth="220" DisplayMemberPath="Name" PlaceholderText="DNS profile"/>
            <Button Content="Apply DNS" Click="ApplyDns_Click" Style="{StaticResource BrandButtonStyle}"/>
            <Button Content="Reset to automatic" Click="ResetDns_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="CustomPrimaryBox" MinWidth="200" PlaceholderText="Custom primary DNS (IPv4 or IPv6)"/>
            <TextBox x:Name="CustomSecondaryBox" MinWidth="200" PlaceholderText="Secondary (optional)"/>
            <Button Content="Apply custom DNS" Click="ApplyCustomDns_Click"/>
        </StackPanel>

        <ListView x:Name="AdapterList" Grid.Row="4">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextBlockStyle}"/>
                            <TextBlock Text="{Binding InterfaceType}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding DnsServers}" VerticalAlignment="Center" Opacity="0.7"/>
                        <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" Opacity="0.8"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <InfoBar x:Name="ResultInfo" Grid.Row="4" VerticalAlignment="Bottom" IsOpen="False" IsClosable="True"/>
    </Grid>
</Page>
