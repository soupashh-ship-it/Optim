<Page
    x:Class="Optim.App.Views.DebloatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="2" Margin="0,0,0,4">
            <TextBlock Text="Debloat" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Installed and provisioned apps. Select what goes — protected system apps stay untouched."
                       Style="{StaticResource CardDescStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SearchBox" MinWidth="220" PlaceholderText="Search apps…"
                     TextChanged="Search_TextChanged" VerticalAlignment="Center"/>
            <Button x:Name="RefreshBtn" Content="Refresh" Click="Refresh_Click"/>
            <Button x:Name="SelectAllBtn" Content="Select all" Click="SelectAll_Click"/>
            <Button x:Name="UninstallBtn" Content="Uninstall selected" Click="Uninstall_Click" Style="{StaticResource BrandButtonStyle}"/>
            <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Opacity="0.5"/>
        </StackPanel>

        <ListView x:Name="PackagesList" Grid.Row="2" SelectionMode="Single" IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="PickBox" IsChecked="{Binding IsSelected, Mode=TwoWay}" Grid.Column="0"/>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyTextBlockStyle}"/>
                            <TextBlock Text="{Binding PackageFamilyName}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Protected" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="Orange" Visibility="{Binding ProtectedVisibility}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
