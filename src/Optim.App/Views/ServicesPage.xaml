<Page
    x:Class="Optim.App.Views.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Optim.App.Views">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="2" Margin="0,0,0,4">
            <TextBlock Text="Services" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Start, stop, restart and reconfigure every Windows service. Boot-critical services are read-only — changing those can stop Windows from booting."
                       Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" MaxWidth="800"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Refresh" Click="Refresh_Click"/>
            <TextBox x:Name="SearchBox" Width="240" PlaceholderText="Search services…" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
            <ToggleButton x:Name="HideMicrosoftToggle" Content="Hide Microsoft services" Click="HideMicrosoft_Click"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Opacity="0.5"/>
        </StackPanel>

        <ListView x:Name="ServicesList" Grid.Row="2">
            <ListView.ItemTemplate>
                <!-- Compiled bindings (x:Bind) instead of reflection-based
                     {Binding}: scrolling hundreds of rows no longer pays for a
                     property lookup per cell. -->
                <DataTemplate x:DataType="local:ServiceRow">
                    <Grid Padding="4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.45" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind StatusText}" VerticalAlignment="Center" Opacity="0.8"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                            <!-- One-way: the row is the single source of truth, so a
                                 recycled container can never push a stale index back
                                 into the service it was just rebound to. -->
                            <ComboBox MinWidth="130" IsEnabled="{x:Bind CanChange}"
                                      SelectedIndex="{x:Bind StartModeIndex, Mode=OneWay}" SelectionChanged="Mode_SelectionChanged">
                                <ComboBoxItem Content="Automatic"/>
                                <ComboBoxItem Content="Manual"/>
                                <ComboBoxItem Content="Disabled"/>
                                <ComboBoxItem Content="Automatic (delayed)"/>
                            </ComboBox>
                            <TextBlock Text="{x:Bind StartModeText}" Opacity="0.55"
                                       Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Content="Start" Click="Start_Click" Padding="8,2" MinWidth="0"
                                    IsEnabled="{x:Bind CanStart}"/>
                            <Button Content="Stop" Click="Stop_Click" Padding="8,2" MinWidth="0"
                                    IsEnabled="{x:Bind CanStop}"/>
                            <Button Content="Restart" Click="Restart_Click" Padding="8,2" MinWidth="0"
                                    IsEnabled="{x:Bind CanStop}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="Boot-critical" Foreground="OrangeRed" VerticalAlignment="Center"
                                   Visibility="{x:Bind CriticalVisibility}" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
