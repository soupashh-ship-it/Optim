<Page
    x:Class="Optim.App.Views.PoliciesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="2" Margin="0,0,0,4">
            <TextBlock Text="Policies" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Group-policy overrides, detected and removable."
                       Style="{StaticResource CardDescStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ScanBtn" Content="Scan" Click="Scan_Click" Style="{StaticResource BrandButtonStyle}"/>
            <Button Content="Export report…" Click="Export_Click"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Opacity="0.6"/>
        </StackPanel>

        <ListView x:Name="FindingsList" Grid.Row="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12" Padding="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Friendly}" Style="{StaticResource CardTitleStyle}" Visibility="{Binding FriendlyVisibility}"/>
                            <TextBlock Text="{Binding Raw}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Opacity="0.75"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Remove" Click="Remove_Click" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
