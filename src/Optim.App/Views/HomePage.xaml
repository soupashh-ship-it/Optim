<Page
    x:Class="Optim.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Optim.App.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock x:Name="GreetingText" Text="Welcome back"
                           Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock x:Name="SubtitleText"
                           Text="Here is what is happening on your machine right now."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Opacity="0.7"/>
            </StackPanel>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBorderStyle}" Grid.Column="0" Grid.Row="0">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Processor" Style="{StaticResource CardDescStyle}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="CpuText" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="72" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <views:UsageGraph x:Name="CpuGraph"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Grid.Column="1" Grid.Row="0">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Memory" Style="{StaticResource CardDescStyle}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="RamText" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="72" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <views:UsageGraph x:Name="RamGraph"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Grid.Column="2" Grid.Row="0">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Disk" Style="{StaticResource CardDescStyle}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="DiskText" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="72" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <views:UsageGraph x:Name="DiskGraph"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Grid.Column="0" Grid.Row="1">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="AppsCountText" Text="—" Style="{StaticResource CountTextStyle}"/>
                        <TextBlock Text="apps installed" Style="{StaticResource CardDescStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Grid.Column="1" Grid.Row="1">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="ServicesCountText" Text="—" Style="{StaticResource CountTextStyle}"/>
                        <TextBlock Text="services registered" Style="{StaticResource CardDescStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Grid.Column="2" Grid.Row="1">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="ProcessesCountText" Text="—" Style="{StaticResource CountTextStyle}"/>
                        <TextBlock Text="processes running" Style="{StaticResource CardDescStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Quick actions" Style="{StaticResource SectionSubtitleStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Clean temp files" Click="CleanTemp_Click"/>
                <Button Content="Empty recycle bin" Click="EmptyRecycleBin_Click"/>
                <Button Content="Flush DNS cache" Click="FlushDns_Click"/>
                <Button Content="Create restore point" Click="RestorePoint_Click"/>
                <Button Content="Scan policies" Click="Policies_Click"/>
            </StackPanel>

            <InfoBar x:Name="ActionInfo" IsOpen="False" IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>
