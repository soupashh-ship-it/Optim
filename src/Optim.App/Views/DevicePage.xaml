<Page
    x:Class="Optim.App.Views.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="0">
            <TextBlock Text="Device" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4"/>
            <TextBlock Text="What Optim sees about this machine." Style="{StaticResource CardDescStyle}" Margin="0,0,0,12"/>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7F8;" FontSize="44" Opacity="0.85"
                              VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="HostText" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock x:Name="SpecText" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Refresh" Click="Refresh_Click" MinWidth="150"/>
                        <Button Content="Export drivers…" Click="ExportDrivers_Click" MinWidth="150"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel x:Name="SectionsPanel" Spacing="8"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
