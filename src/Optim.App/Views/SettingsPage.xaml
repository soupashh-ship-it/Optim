<Page
    x:Class="Optim.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <RadioButtons x:Name="ThemeButtons" SelectionChanged="Theme_SelectionChanged">
                        <RadioButton Content="Light" Tag="Light"/>
                        <RadioButton Content="Dark" Tag="Dark"/>
                        <RadioButton Content="Use system" Tag="Default" IsChecked="True"/>
                    </RadioButtons>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Safety" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="Revert every registry change Optim has journaled, newest first. A restore point is belt and braces for everything else."
                               TextWrapping="Wrap" Opacity="0.8"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Revert all changes" Click="RevertAll_Click" Style="{StaticResource BrandButtonStyle}"/>
                        <Button Content="Create restore point" Click="RestorePoint_Click"/>
                        <TextBlock x:Name="JournalCount" VerticalAlignment="Center" Opacity="0.6"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Backup" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="Export the tweaks currently applied so you can replay them on this PC later."
                               TextWrapping="Wrap" Opacity="0.8"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Export applied…" Click="Export_Click"/>
                        <Button Content="Import…" Click="Import_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Logs" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="View logs" Click="ViewLogs_Click"/>
                        <Button Content="Open log folder" Click="OpenLogs_Click"/>
                        <TextBlock x:Name="LogPathText" VerticalAlignment="Center" Opacity="0.5"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <InfoBar x:Name="ResultInfo" IsOpen="False" IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>
