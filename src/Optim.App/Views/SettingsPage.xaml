<Page
    x:Class="Optim.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <TextBlock x:Uid="Settings_Title" Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>

            <!-- Section rows use the real CommunityToolkit SettingsCard, so they
                 share the platform's hover/press animation. ContentAlignment
                 Vertical stacks the group under its heading instead of squeezing
                 it into the right-hand column. -->
            <controls:SettingsCard x:Uid="Settings_Appearance"
                                   Header="Appearance"
                                   ContentAlignment="Vertical"
                                   IsClickEnabled="False">
                <RadioButtons x:Name="ThemeButtons" SelectionChanged="Theme_SelectionChanged">
                    <RadioButton x:Uid="Settings_Theme_Light" Content="Light" Tag="Light"/>
                    <RadioButton x:Uid="Settings_Theme_Dark" Content="Dark" Tag="Dark"/>
                    <RadioButton x:Uid="Settings_Theme_System" Content="Use system" Tag="Default" IsChecked="True"/>
                </RadioButtons>
            </controls:SettingsCard>

            <controls:SettingsCard x:Uid="Settings_Safety"
                                   Header="Safety"
                                   Description="Revert every registry change Optim has journaled, newest first. A restore point is belt and braces for everything else."
                                   ContentAlignment="Vertical"
                                   IsClickEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Revert all changes" Click="RevertAll_Click" Style="{StaticResource BrandButtonStyle}"/>
                    <Button Content="Create restore point" Click="RestorePoint_Click"/>
                    <TextBlock x:Name="JournalCount" VerticalAlignment="Center" Opacity="0.6"/>
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard x:Uid="Settings_Backup"
                                   Header="Backup"
                                   Description="Export the tweaks currently applied so you can replay them on this PC later."
                                   ContentAlignment="Vertical"
                                   IsClickEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Export applied…" Click="Export_Click"/>
                    <Button Content="Import…" Click="Import_Click"/>
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard x:Uid="Settings_Logs"
                                   Header="Logs"
                                   ContentAlignment="Vertical"
                                   IsClickEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="View logs" Click="ViewLogs_Click"/>
                    <Button Content="Open log folder" Click="OpenLogs_Click"/>
                    <TextBlock x:Name="LogPathText" VerticalAlignment="Center" Opacity="0.5"/>
                </StackPanel>
            </controls:SettingsCard>

            <InfoBar x:Name="ResultInfo" IsOpen="False" IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>
