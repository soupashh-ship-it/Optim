<Application
    x:Class="Optim.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Card container used across all pages -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>

            <!-- Settings-card row container: icon | text | content -->
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="MinHeight" Value="60"/>
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="CardDescStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Opacity" Value="0.72"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="SectionSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Opacity" Value="0.85"/>
            </Style>

            <!-- Big number used on Home stat cards -->
            <Style x:Key="CountTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- Quiet toggle used in settings-card rows -->
            <Style x:Key="RowToggleStyle" TargetType="ToggleSwitch">
                <Setter Property="OnContent" Value=""/>
                <Setter Property="OffContent" Value=""/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="MinWidth" Value="0"/>
            </Style>

            <!-- Optim's own brand accent (teal): used for engine pills and
                 hero details. Theme-independent by design. -->
            <SolidColorBrush x:Key="OptimBrandBrush" Color="#1B9AAA"/>

            <!-- Primary action button in brand teal (white text), so primary
                 actions never clash with the user's system accent. -->
            <Style x:Key="BrandButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource OptimBrandBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="12,6"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
